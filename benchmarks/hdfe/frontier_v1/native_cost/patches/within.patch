+//! Research-only, per-solver cost instrumentation. No numerical policy lives here.
+//!
+//! Counts are actual entry calls, not inferred from iteration counts. Operator
+//! durations sum elapsed time across concurrent RHS and are not additive wall time.
+#![allow(missing_docs)]
+
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::time::Instant;
+use schwarz_precond::{Operator, SolveError};
+
+#[derive(Default)]
+pub(crate) struct Counter {
+    calls: AtomicU64,
+    nanos: AtomicU64,
+}
+
+impl Counter {
+    pub(crate) fn guard(&self, enabled: bool) -> Option<Guard<'_>> {
+        enabled.then(|| {
+            self.calls.fetch_add(1, Ordering::Relaxed);
+            Guard { counter: self, start: Instant::now() }
+        })
+    }
+    fn snapshot(&self) -> OperationCost {
+        OperationCost {
+            calls: self.calls.load(Ordering::Relaxed),
+            seconds: self.nanos.load(Ordering::Relaxed) as f64 * 1e-9,
+        }
+    }
+}
+
+pub(crate) struct Guard<'a> {
+    counter: &'a Counter,
+    start: Instant,
+}
+impl Drop for Guard<'_> {
+    fn drop(&mut self) {
+        self.counter.nanos.fetch_add(
+            self.start.elapsed().as_nanos().min(u64::MAX as u128) as u64,
+            Ordering::Relaxed,
+        );
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct Counters {
+    pub enabled: AtomicBool,
+    pub design_apply: Counter,
+    pub design_adjoint: Counter,
+    pub preconditioner_apply: Counter,
+    pub preconditioner_adjoint: Counter,
+    pub solve: Counter,
+    pub deferred_build: Counter,
+    pub failed_solves: AtomicU64,
+    pub rhs_columns: AtomicU64,
+}
+impl Counters {
+    pub fn enabled(&self) -> bool { self.enabled.load(Ordering::Relaxed) }
+    pub fn snapshot(&self) -> CostTotals {
+        CostTotals {
+            design_apply: self.design_apply.snapshot(),
+            design_adjoint: self.design_adjoint.snapshot(),
+            preconditioner_apply: self.preconditioner_apply.snapshot(),
+            preconditioner_adjoint: self.preconditioner_adjoint.snapshot(),
+            solve: self.solve.snapshot(),
+            deferred_build: self.deferred_build.snapshot(),
+            failed_solves: self.failed_solves.load(Ordering::Relaxed),
+            rhs_columns: self.rhs_columns.load(Ordering::Relaxed),
+        }
+    }
+}
+
+#[derive(Clone, Debug, serde::Serialize)]
+pub struct OperationCost { pub calls: u64, pub seconds: f64 }
+#[derive(Clone, Debug, serde::Serialize)]
+pub struct CostTotals {
+    pub design_apply: OperationCost,
+    pub design_adjoint: OperationCost,
+    pub preconditioner_apply: OperationCost,
+    pub preconditioner_adjoint: OperationCost,
+    pub solve: OperationCost,
+    pub deferred_build: OperationCost,
+    pub failed_solves: u64,
+    pub rhs_columns: u64,
+}
+
+#[derive(Clone, Debug, Default, serde::Serialize)]
+pub struct SchwarzBuildCost {
+    pub domain_assembly_seconds: f64,
+    pub local_factors_wall_seconds: f64,
+}
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, serde::Serialize)]
+pub struct LocalFactorShape {
+    pub eliminated_dim: usize,
+    pub kept_dim: usize,
+    pub factor_solve_dim: usize,
+    pub cross_tab_nnz: usize,
+}
+#[derive(Clone, Debug, serde::Serialize)]
+pub struct LocalFactorGroup { pub shape: LocalFactorShape, pub count: usize }
+#[derive(Clone, Debug, serde::Serialize)]
+pub struct NativeCostSnapshot {
+    pub enabled: bool,
+    pub totals: CostTotals,
+    pub core_constructor_seconds: f64,
+    pub initial_preconditioner_seconds: f64,
+    pub preconditioner_kind: &'static str,
+    pub has_escalated: bool,
+    pub n_obs: usize,
+    pub n_dofs: usize,
+    pub schwarz_build: Option<SchwarzBuildCost>,
+    pub local_factors: Vec<LocalFactorGroup>,
+}
+
+/// Counts the boundary actually used by LSMR, including its residual checks.
+/// Reconstruction and wrapper certificates are outside this boundary.
+pub(crate) struct CountedOperator<'a> {
+    pub inner: &'a dyn Operator,
+    pub forward: &'a Counter,
+    pub adjoint: &'a Counter,
+    pub enabled: bool,
+}
+impl Operator for CountedOperator<'_> {
+    fn nrows(&self) -> usize { self.inner.nrows() }
+    fn ncols(&self) -> usize { self.inner.ncols() }
+    fn apply(&self, x: &[f64], y: &mut [f64]) -> Result<(), SolveError> {
+        let _guard = self.forward.guard(self.enabled);
+        self.inner.apply(x, y)
+    }
+    fn apply_adjoint(&self, x: &[f64], y: &mut [f64]) -> Result<(), SolveError> {
+        let _guard = self.adjoint.guard(self.enabled);
+        self.inner.apply_adjoint(x, y)
+    }
+}
