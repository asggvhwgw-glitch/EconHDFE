+use serde_json::{json, Value};
+#[derive(Clone, Default, serde::Serialize)]
+pub struct WrapperCosts {
+    pub projection_calls: usize,
+    pub projection_errors: usize,
+    pub projection_seconds: f64,
+    pub certificate_calls: usize,
+    pub certificate_seconds: f64,
+    pub polish_calls: usize,
+    pub polish_seconds: f64,
+}
+
+// Difference only cumulative counters/timers. State and constructor metadata are
+// snapshots, not work to add again on each projection. Integer counts stay exact.
+pub fn delta_totals(before: &Value, after: &Value) -> Value {
+    delta(&before["totals"], &after["totals"])
+}
+pub fn delta(before: &Value, after: &Value) -> Value {
+    match after {
+        Value::Object(values) => Value::Object(values.iter()
+            .filter(|(key,value)| !key.starts_with("constructor_") && !value.is_boolean())
+            .map(|(key,value)| (key.clone(),delta(&before[key],value))).collect()),
+        Value::Number(n) if n.is_u64() => json!(n.as_u64().unwrap().saturating_sub(before.as_u64().unwrap_or(0))),
+        Value::Number(n) => json!(n.as_f64().unwrap() - before.as_f64().unwrap_or(0.0)),
+        _ => Value::Null,
+    }
+}
