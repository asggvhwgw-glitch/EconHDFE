+// Evaluate the operation exactly once. Keep its Result intact until after the
+// timer is recorded so failing attempts retain their work. No clock reads occur
+// here when instrumentation is disabled.
+macro_rules! measured {
+    ($d:expr, $calls:ident, $seconds:ident, $op:expr) => {{
+        let started = if $d.enabled {
+            $d.$calls += 1;
+            Some(Instant::now())
+        } else {
+            None
+        };
+        let result = $op;
+        if let Some(started) = started {
+            $d.$seconds += started.elapsed().as_secs_f64();
+        }
+        result
+    }};
+}
 
