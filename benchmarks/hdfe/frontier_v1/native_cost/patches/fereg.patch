+#[test]
+fn diagnostics_opt_in_preserves_projection_bits_and_route() {
+    let d = coupled(44);
+    let cfg = SolverConfig { joint: JointPolicy::Always, ..limit(10) };
+    let mut unmeasured = setup(&d, cfg, 3);
+    let mut measured = setup(&d, cfg, 3);
+    measured.fast.enable_diagnostics(true);
+    let (a, _, info_a, _) = run(&mut unmeasured, None);
+    let (b, _, info_b, _) = run(&mut measured, None);
+    assert_eq!(a, b);
+    assert_eq!(info_a.iterations, info_b.iterations);
+    assert_eq!(info_a.exact, info_b.exact);
+    assert_eq!(info_a.escalated, info_b.escalated);
+    assert_eq!(unmeasured.fast.precond_kinds(), measured.fast.precond_kinds());
+    assert_eq!(unmeasured.fast.diagnostics().totals.residualize_calls, 0);
+    let cold = measured.fast.diagnostics();
+    assert!(cold.state.joint_factor_present);
+    assert_eq!(cold.state.precond_kinds, vec!["joint"]);
+    assert_eq!(cold.state.last_exact, Some(true));
+    assert_eq!(cold.state.last_escalated, Some(true));
+    assert_eq!(cold.totals.residualize_calls, 1);
+    assert_eq!(cold.totals.matvec_calls, 0); // The one exact correction is not a matvec.
+    assert_eq!(cold.totals.precond_calls, 1);
+    assert_eq!(cold.totals.precond_rhs_columns, 3);
+    assert_eq!(cold.totals.exact_precond_calls, 1);
+    assert_eq!(cold.totals.joint_build_successes, 1);
+    assert_eq!(cold.totals.joint_assembly_calls, 1);
+    assert_eq!(cold.totals.joint_analyze_calls, 1);
+    assert_eq!(cold.totals.joint_numeric_calls, 1);
+    assert!(cold.state.joint_matrix_nnz.unwrap() > 0);
+    assert!(cold.state.joint_factor_entries.unwrap() > 0);
+    assert_eq!(cold.state.joint_last_build_outcome, Some("built"));
+    assert!(cold.totals.residualize_seconds >= cold.totals.joint_build_seconds);
+    assert!(cold.totals.joint_build_seconds >= cold.totals.joint_numeric_seconds);
+
+    // Same structure and weights: the cached factor is reused. A nonzero warm
+    // coefficient vector causes an actual residual matvec before correction.
+    let coefs = info_b.coefs.unwrap();
+    run(&mut measured, Some(&coefs));
+    let warm = measured.fast.diagnostics();
+    assert_eq!(warm.totals.residualize_calls, 2);
+    assert_eq!(warm.totals.calls_started_with_joint_factor, 1);
+    assert_eq!(warm.totals.calls_with_warm_coefficients, 1);
+    assert_eq!(warm.totals.joint_build_attempts, cold.totals.joint_build_attempts);
+    assert_eq!(warm.totals.matvec_calls, 1);
+    assert_eq!(warm.totals.matvec_rhs_columns, 3);
+    assert_eq!(warm.totals.precond_calls, 2);
+    assert_eq!(warm.totals.exact_precond_calls, 2);
+    assert_eq!(warm.state.last_escalated, Some(false));
+
+    measured.fast.enable_diagnostics(false);
+    run(&mut measured, None);
+    assert_eq!(measured.fast.diagnostics().totals.residualize_calls, 2);
+}
