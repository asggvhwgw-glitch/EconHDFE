+#[test]
+fn diagnostics_counts_adaptive_restart_operator_calls() {
+    let mut p = setup(&coupled(42), limit(10), 2);
+    p.fast.enable_diagnostics(true);
+    let (_, _, info, _) = run(&mut p, None);
+    let d = p.fast.diagnostics();
+    assert!(info.exact && info.escalated && info.iterations > 1);
+    assert_eq!(d.totals.joint_build_successes, 1);
+    assert_eq!(d.totals.probe_changes, 1);
+    // Each PCG step, plus the restart residual, is one batched matvec. The
+    // final exact correction adds an iteration without another loop matvec.
+    assert_eq!(d.totals.matvec_calls, info.iterations as u64);
+    assert_eq!(d.totals.precond_calls, info.iterations as u64 + 1);
+    assert_eq!(d.totals.exact_precond_calls, 1);
+    assert_eq!(d.totals.matvec_rhs_columns, 2 * d.totals.matvec_calls);
+    assert_eq!(d.totals.precond_rhs_columns, 2 * d.totals.precond_calls);
+    assert!(d.totals.pcg_seconds >= d.totals.joint_build_seconds);
+}
