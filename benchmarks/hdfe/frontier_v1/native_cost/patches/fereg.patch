+//! Opt-in, solver-local work diagnostics for FE projection.
+//!
+//! Counters measure actual API calls, not inferred iteration work. A matvec or
+//! preconditioner call processes one full row-major batch; `*_rhs_columns`
+//! sums its allocated width, including any frozen columns. Timers are elapsed
+//! wall seconds. They are nested: residualize contains PCG, PCG contains
+//! operator/preconditioner calls and adaptive builds, and joint build contains
+//! its assembly/analysis/numeric phases. They must not all be added together.
+//! No timing or counter participates in numerical or routing decisions.
+
+/// Cumulative diagnostics owned by one `FeSolver` (no global or atomic state).
+#[derive(Clone, Debug, Default)]
+pub struct WorkDiagnostics {
+    /// Hot-loop instrumentation is disabled by default. Constructor timings
+    /// below are retained regardless, since construction already has timers.
+    pub enabled: bool,
+    pub constructor_structure_seconds: f64,
+    pub constructor_weights_seconds: f64,
+    pub residualize_calls: u64,
+    pub residualize_errors: u64,
+    pub residualize_seconds: f64,
+    pub weight_update_calls: u64,
+    pub weight_update_errors: u64,
+    pub weight_update_seconds: f64,
+    pub rhs_calls: u64,
+    pub rhs_seconds: f64,
+    pub recovery_calls: u64,
+    pub recovery_seconds: f64,
+    pub pcg_calls: u64,
+    pub pcg_errors: u64,
+    pub pcg_seconds: f64,
+    pub matvec_calls: u64,
+    pub matvec_errors: u64,
+    pub matvec_rhs_columns: u64,
+    pub matvec_seconds: f64,
+    pub precond_calls: u64,
+    pub precond_rhs_columns: u64,
+    pub precond_seconds: f64,
+    /// Calls made when `CgSystem::exact()` was true. This does not count a
+    /// sparse factorization as one matvec or one arithmetic operation.
+    pub exact_precond_calls: u64,
+    pub probe_calls: u64,
+    pub probe_changes: u64,
+    pub probe_seconds: f64,
+    pub escalation_calls: u64,
+    pub escalation_changes: u64,
+    pub escalation_seconds: f64,
+    pub small_build_calls: u64,
+    pub small_build_errors: u64,
+    pub small_build_seconds: f64,
+    pub large_block_build_calls: u64,
+    pub large_block_build_errors: u64,
+    pub large_block_build_seconds: f64,
+    pub joint_build_attempts: u64,
+    pub joint_build_successes: u64,
+    /// Returned errors, not ordinary cost/budget rejections (`Ok(None)`).
+    pub joint_build_errors: u64,
+    pub joint_build_seconds: f64,
+    pub joint_aggregation_calls: u64,
+    pub joint_aggregation_seconds: f64,
+    pub joint_pattern_calls: u64,
+    pub joint_pattern_seconds: f64,
+    pub joint_assembly_calls: u64,
+    pub joint_assembly_errors: u64,
+    pub joint_assembly_seconds: f64,
+    /// Includes lower-triangle extraction, ordering and symbolic analysis.
+    /// It is not a symbolic-only time excluding AMD.
+    pub joint_analyze_calls: u64,
+    pub joint_analyze_seconds: f64,
+    pub joint_numeric_calls: u64,
+    /// Returned errors and numerical rejection (`Ok(false)`).
+    pub joint_numeric_errors: u64,
+    pub joint_numeric_seconds: f64,
+    /// Same-pattern refactor API: includes scaling and pattern validation before
+    /// numeric factorization. Counted separately from initial `factor()` calls.
+    pub joint_refactor_calls: u64,
+    /// Returned errors and rejection (`Ok(false)`, including pattern changes).
+    pub joint_refactor_errors: u64,
+    pub joint_refactor_seconds: f64,
+    /// A numeric refresh may fall back to a full joint rebuild. Its inclusive
+    /// time overlaps `joint_build_seconds` in that case.
+    pub joint_refresh_calls: u64,
+    pub joint_refresh_errors: u64,
+    pub joint_refresh_seconds: f64,
+    pub calls_started_with_joint_factor: u64,
+    pub calls_started_with_small_factor: u64,
+    pub calls_with_warm_coefficients: u64,
+}
+
+/// Current cache/structure state plus the outcome of the last instrumented call.
+#[derive(Clone, Debug, Default)]
+pub struct DiagnosticState {
+    pub last_rhs_width: usize,
+    /// `None` after a failed call or before any instrumented call.
+    pub last_exact: Option<bool>,
+    pub last_escalated: Option<bool>,
+    pub last_success: Option<bool>,
+    pub precond_kinds: Vec<&'static str>,
+    pub joint_factor_present: bool,
+    /// Allocated factor values (`len_val`), which can include supernodal
+    /// padding. This must not be relabelled exact numerical nnz(L).
+    pub joint_factor_entries: Option<usize>,
+    /// Actual full-CSR nnz of the most recently assembled joint candidate.
+    /// It may describe a rejected candidate when no joint factor is present.
+    pub joint_matrix_nnz: Option<u64>,
+    pub joint_structural_nnz: Option<u64>,
+    pub joint_analyzed_factor_entries: Option<usize>,
+    /// Symbolic factorization work estimate, not an instrumented flop count.
+    pub joint_symbolic_flops: Option<f64>,
+    pub joint_last_build_outcome: Option<&'static str>,
+    pub joint_pattern_cached: bool,
+    pub joint_aggregation_cached: bool,
+    pub joint_failed: bool,
+    pub small_factor_present: bool,
+    pub small_factor_kind: Option<&'static str>,
+    pub small_sparse_factor_entries: Option<usize>,
+    pub large_sparse_factor_entries: usize,
+    pub basic_fresh: bool,
+    pub small_fresh: bool,
+    pub large_fresh: bool,
+    pub n_obs: usize,
+    pub n_cells: usize,
+    pub reduced_dim: usize,
+    pub m_small: usize,
+    pub n_blocks: usize,
+}
+
+/// A cheap owned snapshot; wrappers may take differences of numeric totals.
+#[derive(Clone, Debug, Default)]
+pub struct DiagnosticsSnapshot {
+    pub totals: WorkDiagnostics,
+    pub state: DiagnosticState,
+}
+
+#[derive(Clone, Debug, Default)]
+pub(crate) struct LastCall {
+    pub rhs_width: usize,
+    pub exact: Option<bool>,
+    pub escalated: Option<bool>,
+    pub success: Option<bool>,
+}
